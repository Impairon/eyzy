{
  "$description": "Katib design tokens (W3C DTCG format). Source of truth for app/src/main/java/app/katib/ui/Tokens.kt. Tiers: primitive → semantic → component. Components never reference primitives directly.",
  "primitive": {
    "color": {
      "paper": {
        "50":  { "$type": "color", "$value": "#F4F1EA" },
        "100": { "$type": "color", "$value": "#ECE7DC" },
        "200": { "$type": "color", "$value": "#DCD5C6" }
      },
      "ink": {
        "900": { "$type": "color", "$value": "#161614" },
        "600": { "$type": "color", "$value": "#5E5A52" }
      },
      "night": {
        "950": { "$type": "color", "$value": "#121211" },
        "900": { "$type": "color", "$value": "#1C1B19" },
        "700": { "$type": "color", "$value": "#302E2A" }
      },
      "chalk": {
        "100": { "$type": "color", "$value": "#ECE8DF" },
        "400": { "$type": "color", "$value": "#A39E93" }
      },
      "vermilion": {
        "600": { "$type": "color", "$value": "#C93A1E" },
        "400": { "$type": "color", "$value": "#FF6A4D" }
      },
      "moss": {
        "700": { "$type": "color", "$value": "#3D6A35" },
        "300": { "$type": "color", "$value": "#8DBF7E" }
      }
    },
    "size": {
      "2": { "$type": "dimension", "$value": "2dp" },
      "4": { "$type": "dimension", "$value": "4dp" },
      "8": { "$type": "dimension", "$value": "8dp" },
      "12": { "$type": "dimension", "$value": "12dp" },
      "16": { "$type": "dimension", "$value": "16dp" },
      "20": { "$type": "dimension", "$value": "20dp" },
      "24": { "$type": "dimension", "$value": "24dp" },
      "32": { "$type": "dimension", "$value": "32dp" },
      "48": { "$type": "dimension", "$value": "48dp" }
    },
    "font": {
      "display.latin": { "$type": "fontFamily", "$value": "Instrument Serif" },
      "display.arabic": { "$type": "fontFamily", "$value": "Amiri" },
      "text": { "$type": "fontFamily", "$value": "IBM Plex Sans Arabic" },
      "mono": { "$type": "fontFamily", "$value": "IBM Plex Mono" }
    }
  },
  "semantic": {
    "color": {
      "bg.canvas":        { "$type": "color", "$value": { "light": "{primitive.color.paper.50}",  "dark": "{primitive.color.night.950}" } },
      "bg.raised":        { "$type": "color", "$value": { "light": "{primitive.color.paper.100}", "dark": "{primitive.color.night.900}" } },
      "border.hairline":  { "$type": "color", "$value": { "light": "{primitive.color.paper.200}", "dark": "{primitive.color.night.700}" } },
      "text.primary":     { "$type": "color", "$value": { "light": "{primitive.color.ink.900}",   "dark": "{primitive.color.chalk.100}" } },
      "text.muted":       { "$type": "color", "$value": { "light": "{primitive.color.ink.600}",   "dark": "{primitive.color.chalk.400}" } },
      "action.primary":   { "$type": "color", "$value": { "light": "{primitive.color.ink.900}",   "dark": "{primitive.color.chalk.100}" },
                            "$description": "Primary actions are solid ink. There is no brand hue for buttons." },
      "signal.live":      { "$type": "color", "$value": { "light": "{primitive.color.vermilion.600}", "dark": "{primitive.color.vermilion.400}" },
                            "$description": "Reserved for live/irreversible states: recording, destructive actions, warnings. Never decorative." },
      "status.verified":  { "$type": "color", "$value": { "light": "{primitive.color.moss.700}", "dark": "{primitive.color.moss.300}" } }
    },
    "space": {
      "xs":     { "$type": "dimension", "$value": "{primitive.size.4}" },
      "s":      { "$type": "dimension", "$value": "{primitive.size.8}" },
      "m":      { "$type": "dimension", "$value": "{primitive.size.16}" },
      "l":      { "$type": "dimension", "$value": "{primitive.size.24}" },
      "xl":     { "$type": "dimension", "$value": "{primitive.size.32}" },
      "gutter": { "$type": "dimension", "$value": "{primitive.size.20}" }
    },
    "radius": {
      "tag":   { "$type": "dimension", "$value": "{primitive.size.2}" },
      "card":  { "$type": "dimension", "$value": "{primitive.size.4}" },
      "sheet": { "$type": "dimension", "$value": "{primitive.size.8}" }
    },
    "stroke": {
      "hairline": { "$type": "dimension", "$value": "1dp" },
      "rule":     { "$type": "dimension", "$value": "1.5dp" }
    },
    "motion": {
      "duration.fast": { "$type": "duration", "$value": "120ms" },
      "duration.base": { "$type": "duration", "$value": "220ms" },
      "duration.slow": { "$type": "duration", "$value": "420ms" },
      "easing.standard": { "$type": "cubicBezier", "$value": [0.2, 0.0, 0.0, 1.0] }
    },
    "type": {
      "display": { "$type": "typography", "$value": { "fontFamily": "display", "fontSize": "40sp", "lineHeight": "44sp" } },
      "title":   { "$type": "typography", "$value": { "fontFamily": "display", "fontSize": "28sp", "lineHeight": "32sp" } },
      "body":    { "$type": "typography", "$value": { "fontFamily": "{primitive.font.text}", "fontSize": "17sp", "lineHeight": "27sp" } },
      "label":   { "$type": "typography", "$value": { "fontFamily": "{primitive.font.mono}", "fontSize": "11sp", "letterSpacing": "1.2sp", "textCase": "uppercase" } },
      "numeric": { "$type": "typography", "$value": { "fontFamily": "{primitive.font.mono}", "fontSize": "13sp" } }
    }
  },
  "component": {
    "button.primary.bg":   { "$type": "color", "$value": "{semantic.color.action.primary}" },
    "button.record.idle":  { "$type": "color", "$value": "{semantic.color.text.primary}" },
    "button.record.live":  { "$type": "color", "$value": "{semantic.color.signal.live}" },
    "tag.border":          { "$type": "color", "$value": "{semantic.color.border.hairline}" },
    "tag.radius":          { "$type": "dimension", "$value": "{semantic.radius.tag}" },
    "card.radius":         { "$type": "dimension", "$value": "{semantic.radius.card}" },
    "nav.indicator":       { "$type": "color", "$value": "{semantic.color.text.primary}" },
    "transcript.rule":     { "$type": "dimension", "$value": "{semantic.stroke.rule}" }
  }
}
