+        private fun openMenu() {
+            val dm = resources.displayMetrics
+            val lp = layoutParams as WindowManager.LayoutParams
+            menu = true
+            menuOriginX = lp.x
+            menuOriginY = lp.y
+            // open towards the middle of the screen and keep the circle exactly where it was
+            menuBallLeft = lp.x + dp(29) < dm.widthPixels / 2
+            lp.width = dp(250)
+            lp.height = minOf(dp(457), dm.heightPixels)
+            menuScale = lp.height / dp(457).toFloat()
+            val maxX = (dm.widthPixels - lp.width).coerceAtLeast(0)
+            val maxY = (dm.heightPixels - lp.height).coerceAtLeast(0)
+            lp.x = (if (menuBallLeft) menuOriginX else menuOriginX - dp(192)).coerceIn(0, maxX)
+            lp.y = (menuOriginY - (lp.height - dp(58)) / 2).coerceIn(0, maxY)
+            menuBallCx = menuOriginX + dp(29) - lp.x
+            menuBallCy = menuOriginY + dp(29) - lp.y
+            translationX = 0f
+            lp.flags = WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL or
+                WindowManager.LayoutParams.FLAG_WATCH_OUTSIDE_TOUCH
+            wm.updateViewLayout(this, lp)
+            isFocusableInTouchMode = true
+            requestFocus()
+            invalidate()
+        }
