+        /** The finger lifted (or the touch was cancelled) after a drag: remember where the circle is. */
+        private fun endDrag() {
+            dragging = false
+            (layoutParams as? WindowManager.LayoutParams)?.let { lp ->
+                getSharedPreferences("avb", Context.MODE_PRIVATE).edit()
+                    .putInt("control_x", lp.x).putInt("control_y", lp.y).apply()
+            }
+            removeCallbacks(fade)
+            postDelayed(fade, 2200)
+        }
