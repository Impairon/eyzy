+    /** Only groups show avatars; in a private chat or channel the bubbles start at the left edge. */
+    private fun isTelegramGroup(sc: Scan): Boolean {
+        val dp = resources.displayMetrics.density
+        val now = SystemClock.uptimeMillis()
+        val leftDp = if (sc.minLeft == Int.MAX_VALUE) -1f else sc.minLeft / dp
+        if (sc.groupWord || leftDp in 55f..100f) tgGroupAt = now
+        else if (sc.headerSeen || leftDp in 0f..50f) tgGroupAt = 0L
+        return tgGroupAt != 0L && now - tgGroupAt < 8000L
+    }
